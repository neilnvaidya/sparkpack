  "title": "Number and Place Value",
  "description": "Counting in multiples, place value in three-digit numbers, and comparing, ordering, reading and writing numbers to 1000.",
  "objectives": [
    {
      "code": "Y3-NPV-1",
      "statement": "Count from 0 in multiples of 4, 8, 50 and 100; find 10 or 100 more or less than a given number."
    },
    {
      "code": "Y3-NPV-2",
      "statement": "Recognise the place value of each digit in a three-digit number (hundreds, tens, ones)."
    },
    {
      "code": "Y3-NPV-3",
      "statement": "Compare and order numbers up to 1000."
    },
    {
      "code": "Y3-NPV-4",
      "statement": "Identify, represent and estimate numbers using different representations."
    },
    {
      "code": "Y3-NPV-5",
      "statement": "Read and write numbers up to 1000 in numerals and in words."
    },
    {
      "code": "Y3-NPV-6",
      "statement": "Solve number problems and practical problems involving these ideas."
    }
  ],
