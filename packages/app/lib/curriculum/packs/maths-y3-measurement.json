  "schemaVersion": 2,
  "id": "maths-y3-measurement",
  "subject": "maths",
  "keyStage": "KS2",
  "year": 3,
  "topicId": "measurement",
  "title": "Measurement",
  "description": "Length, mass, capacity, perimeter, money including giving change, and time on analogue and digital clocks.",
  "objectives": [
    {
      "code": "Y3-M-1",
      "statement": "Measure, compare, add and subtract: lengths (m/cm/mm); mass (kg/g); volume/capacity (l/ml)."
    },
    {
      "code": "Y3-M-2",
      "statement": "Measure the perimeter of simple 2-D shapes."
    },
    {
      "code": "Y3-M-3",
      "statement": "Add and subtract amounts of money to give change, using both £ and p in practical contexts."
    },
    {
      "code": "Y3-M-4",
      "statement": "Tell and write the time from an analogue clock, including using Roman numerals from I to XII, and 12-hour and 24-hour clocks."
    },
    {
      "code": "Y3-M-5",
      "statement": "Estimate and read time with increasing accuracy to the nearest minute; record and compare time in terms of seconds, minutes and hours; use vocabulary such as o'clock, a.m./p.m., morning, afternoon, noon and midnight."
    },
    {
      "code": "Y3-M-6",
      "statement": "Know the number of seconds in a minute and the number of days in each month, year and leap year; compare durations of events."
    }
  ],
