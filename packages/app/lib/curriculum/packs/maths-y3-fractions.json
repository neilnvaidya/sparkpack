  "title": "Fractions",
  "description": "Tenths, fractions of amounts, fractions as numbers, equivalent fractions, and adding, subtracting, comparing and ordering fractions with the same denominator.",
  "objectives": [
    { "code": "Y3-F-1", "statement": "Count up and down in tenths; recognise that tenths arise from dividing an object into 10 equal parts and in dividing one-digit numbers or quantities by 10." },
    { "code": "Y3-F-2", "statement": "Recognise, find and write fractions of a discrete set of objects: unit fractions and non-unit fractions with small denominators." },
    { "code": "Y3-F-3", "statement": "Recognise and use fractions as numbers: unit fractions and non-unit fractions with small denominators." },
    { "code": "Y3-F-4", "statement": "Recognise and show, using diagrams, equivalent fractions with small denominators." },
    { "code": "Y3-F-5", "statement": "Add and subtract fractions with the same denominator within one whole (for example, 5/7 + 1/7 = 6/7)." },
    { "code": "Y3-F-6", "statement": "Compare and order unit fractions, and fractions with the same denominators." },
    { "code": "Y3-F-7", "statement": "Solve problems that involve all of the above." }
  ],
