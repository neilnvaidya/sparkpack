    {
      "code": "Y34-SP-1",
      "statement": "Use further prefixes and understand how to add them (for example, un–, dis–, mis–, in–, re–, sub–, super–, anti–, auto–)."
    },
    {
      "code": "Y34-SP-2",
      "statement": "Use further suffixes and understand how to add them (for example, –ation, –ly, –ous)."
    },
    {
      "code": "Y34-SP-3",
      "statement": "Spell words that are often confused, including common homophones (for example, there/their/they're, here/hear)."
    },
    {
      "code": "Y34-SP-4",
      "statement": "Spell words from the Year 3 and 4 list of commonly misspelt words."
    }
