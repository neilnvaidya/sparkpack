  "title": "Grammar and Punctuation",
  "description": "Lower Key Stage 2 grammar and punctuation: word classes, conjunctions, the a/an rule, inverted commas for speech, and paragraphs (English Appendix 2, Years 3 and 4).",
  "objectives": [
    {
      "code": "Y34-GP-1",
      "statement": "Identify word classes: nouns, verbs, adjectives and adverbs."
    },
    {
      "code": "Y34-GP-2",
      "statement": "Express time, place and cause using conjunctions, adverbs and prepositions."
    },
    {
      "code": "Y34-GP-3",
      "statement": "Use the forms 'a' or 'an' according to whether the next word begins with a consonant or a vowel sound."
    },
    {
      "code": "Y34-GP-4",
      "statement": "Use and punctuate direct speech with inverted commas (speech marks)."
    },
    {
      "code": "Y34-GP-5",
      "statement": "Use paragraphs to organise ideas around a theme."
    }
  ],
