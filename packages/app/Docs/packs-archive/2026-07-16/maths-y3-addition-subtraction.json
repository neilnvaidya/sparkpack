  "title": "Addition and Subtraction",
  "description": "Mental and columnar addition and subtraction with numbers up to three digits, estimating, checking with inverses, and missing-number problems.",
  "objectives": [
    {
      "code": "Y3-AS-1",
      "statement": "Add and subtract numbers mentally, including: a three-digit number and ones; a three-digit number and tens; a three-digit number and hundreds."
    },
    {
      "code": "Y3-AS-2",
      "statement": "Add and subtract numbers with up to three digits, using formal written methods of columnar addition and subtraction."
    },
    {
      "code": "Y3-AS-3",
      "statement": "Estimate the answer to a calculation and use inverse operations to check answers."
    },
    {
      "code": "Y3-AS-4",
      "statement": "Solve problems, including missing number problems, using number facts, place value, and more complex addition and subtraction."
    }
  ],
